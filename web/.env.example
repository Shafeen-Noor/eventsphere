# Postgres (Neon / Supabase / Vercel Postgres / local Docker)
# Neon: use the pooled connection string ending in -pooler
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Amazon S3 storage
# Must match the bucket's real region (check S3 console)
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET="your-eventsphere-bucket"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
# Optional if using temporary credentials
# AWS_SESSION_TOKEN=""

# Force local disk storage instead of S3 (useful for offline demos)
# STORAGE_DRIVER="local"

# App — public URL used in QR codes / invite links.
# On Vercel set this to your production alias (NOT a deployment *.vercel.app URL):
# NEXT_PUBLIC_APP_URL="https://eventsphere-orcin.vercel.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
