# SQLite database (relative to /web)
DATABASE_URL="file:./dev.db"

# Amazon S3 storage
# Must match the bucket's real region (check S3 console)
AWS_REGION="ap-southeast-2"
AWS_S3_BUCKET="your-eventsphere-bucket"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
# Optional if using temporary credentials
# AWS_SESSION_TOKEN=""

# Force local disk storage instead of S3 (useful for offline demos)
# STORAGE_DRIVER="local"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
