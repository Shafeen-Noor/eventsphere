generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  displayName      String
  email            String?   @unique
  passwordHash     String?
  organizationName String?
  hostType         String?
  plan             String    @default("free")
  emailVerifiedAt  DateTime?
  otpHash          String?
  otpExpiresAt     DateTime?
  apiTokenHash     String?
  createdAt        DateTime  @default(now())

  sessions              Session[]
  memberships           Membership[]
  ownedEvents           Event[]               @relation("EventOwner")
  media                 Media[]
  likes                 MediaLike[]
  comments              MediaComment[]
  reports               MediaReport[]
  rsvps                 Rsvp[]
  mediaReactions        MediaReaction[]
  photoVotes            PhotoVote[]
  guestbookEntries      GuestbookEntry[]
  pollVotes             PollVote[]
  challengeSubmissions  ChallengeSubmission[]
  seatAssignments       SeatAssignment[]
  feedItems             FeedItem[]            @relation("FeedActor")
  audioMemories         AudioMemory[]
  guestBadges           GuestBadge[]
  faceTags              FaceTag[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Event {
  id                  String    @id @default(cuid())
  slug                String    @unique
  title               String
  description         String    @default("")
  useCase             String    @default("friends")
  eventType           String    @default("party")
  state               String    @default("scheduled")
  coverKey            String?
  locationName        String    @default("")
  startAt             DateTime?
  endAt               DateTime?
  expiresAt           DateTime
  retentionHours      Int       @default(24)
  passcodeHash        String?
  rsvpEnabled         Boolean   @default(false)
  commentsEnabled     Boolean   @default(true)
  uploadsEnabled      Boolean   @default(true)
  requireRsvpToUpload Boolean   @default(false)
  allowPlusOnes       Boolean   @default(true)
  maxPlusOnes         Int       @default(2)
  uploadMode          String    @default("both")
  useGuestPrivileges  Boolean   @default(false)
  atmosphere          String    @default("bday")
  themeColor          String    @default("#698ea2")
  downloadPolicy      String    @default("members")
  downloadsEnabled    Boolean   @default(true)
  downloadOpensAt     DateTime?
  billingMode         String    @default("free")
  planTier            String    @default("free")
  instantFeeCents     Int       @default(0)
  highlightsPublished Boolean   @default(false)
  highlightTemplate   String    @default("mosaic")
  highlightFilter     String    @default("none")
  maxGuests           Int       @default(5)
  maxMedia            Int       @default(40)
  maxMediaPerGuest    Int       @default(10)
  uploadWindowHours   Int?
  uploadsOpenAt       DateTime?
  uploadsCloseAt      DateTime?
  mapsUrl             String    @default("")
  inviteCopy          String    @default("")
  inviteStickers      String    @default("")
  guestVisibility     String    @default("all_members")
  requireApproval     Boolean   @default(false)
  publishMessage      String    @default("")
  publishedAt         DateTime?
  disposableCamera    Boolean   @default(false)
  whiteLabel          Boolean   @default(false)
  customDomain        String?
  hideUntilEventEnd   Boolean   @default(false)
  featuredMediaId     String?
  featuredUntil       DateTime?
  ownerId             String
  owner               User      @relation("EventOwner", fields: [ownerId], references: [id])
  featuredMedia       Media?    @relation("EventFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships      Membership[]
  media            Media[]      @relation("EventMedia")
  rsvps            Rsvp[]
  photoVotes       PhotoVote[]
  guestbookEntries GuestbookEntry[]
  scheduleItems    ScheduleItem[]
  storyChapters    StoryChapter[]
  polls            Poll[]
  challenges       Challenge[]
  seatingTables    SeatingTable[]
  feedItems        FeedItem[]
  audioMemories    AudioMemory[]
  guestBadges      GuestBadge[]
  faceCollections  FaceCollection[]
  eventRecap       EventRecap?
}

model Membership {
  id                 String   @id @default(cuid())
  eventId            String
  userId             String
  role               String   @default("guest")
  status             String   @default("active")
  canUpload          Boolean  @default(true)
  canDownload        Boolean  @default(true)
  contactEmail       String?
  contactWhatsapp    String?
  notificationsOptIn Boolean  @default(true)
  joinedAt           DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Rsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("going")
  plusOnes  Int      @default(0)
  note      String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Media {
  id             String    @id @default(cuid())
  eventId        String
  uploaderId     String
  type           String    @default("image")
  state          String    @default("published")
  storageKey     String
  thumbKey       String?
  contentType    String
  byteSize       Int
  checksum       String?
  width          Int?
  height         Int?
  caption        String    @default("")
  aiCaption      String?
  lat            Float?
  lng            Float?
  scheduleItemId String?
  hiddenUntil    DateTime?
  unlockAt       DateTime?
  featuredUntil  DateTime?
  isHighlight    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  event           Event            @relation("EventMedia", fields: [eventId], references: [id], onDelete: Cascade)
  uploader        User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  scheduleItem    ScheduleItem?    @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  likes           MediaLike[]
  comments        MediaComment[]
  reports         MediaReport[]
  reactions       MediaReaction[]
  photoVotes      PhotoVote[]
  challengeSubs   ChallengeSubmission[]
  feedItems       FeedItem[]
  faceTags        FaceTag[]
  featuredOnEvents Event[]         @relation("EventFeaturedMedia")

  @@unique([eventId, checksum])
  @@index([eventId, createdAt])
  @@index([scheduleItemId])
}

model MediaLike {
  mediaId   String
  userId    String
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([mediaId, userId])
}

model MediaComment {
  id        String   @id @default(cuid())
  mediaId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
}

model MediaReport {
  id         String   @id @default(cuid())
  mediaId    String
  reporterId String
  reason     String
  notes      String   @default("")
  status     String   @default("open")
  createdAt  DateTime @default(now())

  media    Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  reporter User  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

model MediaReaction {
  id        String   @id @default(cuid())
  mediaId   String
  userId    String
  emoji     String   @default("heart")
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mediaId, userId, emoji])
  @@index([mediaId])
}

model PhotoVote {
  id        String   @id @default(cuid())
  eventId   String
  mediaId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([mediaId])
}

model GuestbookEntry {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  body         String
  signatureSvg String?
  createdAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model ScheduleItem {
  id          String    @id @default(cuid())
  eventId     String
  title       String
  description String    @default("")
  location    String    @default("")
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  event Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media[]

  @@index([eventId, sortOrder])
}

model StoryChapter {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  body      String   @default("")
  mediaIds  String   @default("[]")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sortOrder])
}

model Poll {
  id        String    @id @default(cuid())
  eventId   String
  kind      String    @default("choice")
  question  String
  status    String    @default("open")
  closesAt  DateTime?
  createdAt DateTime  @default(now())

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([eventId])
}

model PollOption {
  id        String   @id @default(cuid())
  pollId    String
  label     String
  sortOrder Int      @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, sortOrder])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
}

model Challenge {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String   @default("")
  status      String   @default("open")
  createdAt   DateTime @default(now())

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions ChallengeSubmission[]

  @@index([eventId])
}

model ChallengeSubmission {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  mediaId     String?
  caption     String   @default("")
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([challengeId, userId])
  @@index([mediaId])
}

model SeatingTable {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  capacity  Int      @default(8)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments SeatAssignment[]

  @@index([eventId, sortOrder])
}

model SeatAssignment {
  id        String   @id @default(cuid())
  tableId   String
  userId    String?
  guestName String   @default("")
  seatLabel String   @default("")
  createdAt DateTime @default(now())

  table SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableId])
  @@index([userId])
}

model FeedItem {
  id        String   @id @default(cuid())
  eventId   String
  type      String
  actorId   String?
  mediaId   String?
  title     String   @default("")
  body      String   @default("")
  payload   String   @default("")
  createdAt DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User?  @relation("FeedActor", fields: [actorId], references: [id], onDelete: SetNull)
  media Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
}

model AudioMemory {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  storageKey  String
  contentType String   @default("audio/webm")
  byteSize    Int      @default(0)
  durationMs  Int      @default(0)
  caption     String   @default("")
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model GuestBadge {
  id         String   @id @default(cuid())
  eventId    String
  userId     String
  level      String   @default("newcomer")
  uploads    Int      @default(0)
  likes      Int      @default(0)
  reactions  Int      @default(0)
  guestbook  Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model FaceCollection {
  id        String   @id @default(cuid())
  eventId   String
  label     String
  createdAt DateTime @default(now())

  event Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tags  FaceTag[]

  @@index([eventId])
}

model FaceTag {
  id           String   @id @default(cuid())
  collectionId String
  mediaId      String
  userId       String?
  confidence   Float    @default(0)
  boxJson      String   @default("")
  createdAt    DateTime @default(now())

  collection FaceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  media      Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mediaId])
  @@index([collectionId])
  @@index([userId])
}

model EventRecap {
  id         String   @id @default(cuid())
  eventId    String   @unique
  summary    String   @default("")
  highlights String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model DemoLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  company      String   @default("")
  message      String   @default("")
  planInterest String   @default("enterprise")
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}
